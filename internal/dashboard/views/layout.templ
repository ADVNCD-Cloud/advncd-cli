package views

type Crumb struct {
	Label string
	Href  string
}

// LayoutCtx holds sidebar footer data — project / region / token info.
type LayoutCtx struct {
	ProjectID      string
	Region         string
	Email          string
	TokenExpiresIn string // Go duration string e.g. "59m59s"
	AuthStatus     string // ok / missing / expired
	ServiceCount   int    // -1 = unknown
}

templ Layout(title string, active string, crumbs []Crumb, lctx LayoutCtx, content templ.Component) {
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title} · ADVNCD</title>
	<meta name="token-expires-in" content={lctx.TokenExpiresIn} />

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600&display=swap" rel="stylesheet" />
	<script src="https://unpkg.com/htmx.org@1.9.12"></script>

	<style>
		*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

		:root {
			--bg:#0a0a0b; --bg2:#111113; --bg3:#18181b; --bg4:#1f1f23;
			--border:rgba(255,255,255,0.07); --border2:rgba(255,255,255,0.12);
			--t1:#f4f4f5; --t2:#a1a1aa; --t3:#52525b;
			--green:#6ee7b7; --green-bg:rgba(110,231,183,0.08); --green-border:rgba(110,231,183,0.18);
			--yellow:#fbbf24; --yellow-bg:rgba(251,191,36,0.07); --yellow-border:rgba(251,191,36,0.2);
			--red:#f87171; --red-bg:rgba(248,113,113,0.08); --red-border:rgba(248,113,113,0.2);
			--blue:#60a5fa; --blue-bg:rgba(96,165,250,0.08);
			--mono:'Geist Mono',monospace; --sans:'Geist',sans-serif;
			--r:8px; --r2:12px;
		}

		html, body { height: 100%; }

		body {
			background: var(--bg);
			color: var(--t1);
			font-family: var(--sans);
			font-size: 13px;
			line-height: 1.5;
			-webkit-font-smoothing: antialiased;
		}

		/* Scrollbar */
		::-webkit-scrollbar { width: 3px; }
		::-webkit-scrollbar-track { background: transparent; }
		::-webkit-scrollbar-thumb { background: var(--bg4); border-radius: 2px; }

		/* App shell */
		.app { display: flex; height: 100vh; overflow: hidden; }

		/* ── Sidebar ─────────────────────────────────────── */
		.sidebar {
			width: 200px;
			min-width: 200px;
			background: var(--bg);
			border-right: 1px solid var(--border);
			display: flex;
			flex-direction: column;
			overflow: hidden;
		}

		.sidebar-logo {
			padding: 18px 14px 14px;
			border-bottom: 1px solid var(--border);
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.logo-mark {
			width: 22px;
			height: 22px;
			background: linear-gradient(135deg, #6ee7b7, #60a5fa);
			border-radius: 5px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: var(--mono);
			font-weight: 700;
			font-size: 12px;
			color: #0a0a0b;
			flex-shrink: 0;
		}

		.logo-name {
			font-family: var(--mono);
			font-size: 13px;
			font-weight: 600;
			color: var(--t1);
			letter-spacing: 0.04em;
		}

		.sidebar-nav {
			flex: 1;
			padding: 8px 8px;
			overflow-y: auto;
		}

		.nav-section-label {
			font-size: 10px;
			font-weight: 500;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--t3);
			padding: 0 6px;
			margin: 12px 0 3px;
		}

		.nav-item {
			display: flex;
			align-items: center;
			gap: 7px;
			padding: 6px 8px;
			border-radius: 7px;
			font-size: 12px;
			color: var(--t2);
			text-decoration: none;
			cursor: pointer;
			transition: background 0.1s, color 0.1s;
		}

		.nav-item:hover { background: var(--bg3); color: var(--t1); }
		.nav-item.active { background: var(--bg4); color: var(--t1); }
		.nav-item svg { flex-shrink: 0; opacity: 0.7; }
		.nav-item.active svg, .nav-item:hover svg { opacity: 1; }

		.nav-badge {
			font-size: 10px;
			font-family: var(--mono);
			background: var(--bg4);
			color: var(--t3);
			padding: 1px 5px;
			border-radius: 4px;
			margin-left: 2px;
		}

		.nav-item.active .nav-badge { color: var(--t2); }

		.nav-ext {
			margin-left: auto;
			font-size: 10px;
			color: var(--t3);
		}

		.sidebar-footer {
			padding: 10px 12px;
			border-top: 1px solid var(--border);
			display: flex;
			flex-direction: column;
			gap: 5px;
		}

		.footer-row {
			display: flex;
			align-items: center;
			gap: 7px;
		}

		.footer-dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			flex-shrink: 0;
		}

		.footer-label {
			font-family: var(--mono);
			font-size: 10px;
			color: var(--t3);
			width: 46px;
			min-width: 46px;
		}

		.footer-val {
			font-family: var(--mono);
			font-size: 10px;
			color: var(--t2);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		/* ── Main ─────────────────────────────────────────── */
		.main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

		/* ── Topbar ───────────────────────────────────────── */
		.topbar {
			height: 48px;
			min-height: 48px;
			border-bottom: 1px solid var(--border);
			display: flex;
			align-items: center;
			padding: 0 16px;
			gap: 10px;
			flex-shrink: 0;
		}

		.breadcrumb {
			flex: 1;
			display: flex;
			align-items: center;
			gap: 4px;
			font-family: var(--mono);
			font-size: 11px;
		}

		.bc-sep { color: var(--t3); }
		.bc-parent { color: var(--t3); text-decoration: none; }
		.bc-parent:hover { color: var(--t2); }
		.bc-current { color: var(--t1); font-weight: 500; }

		.topbar-right {
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.clock {
			font-family: var(--mono);
			font-size: 10px;
			color: var(--t3);
		}

		/* ── Buttons ──────────────────────────────────────── */
		.btn {
			display: inline-flex;
			align-items: center;
			gap: 4px;
			padding: 5px 11px;
			border-radius: var(--r);
			font-size: 11px;
			font-weight: 500;
			cursor: pointer;
			border: 1px solid var(--border2);
			background: transparent;
			color: var(--t2);
			font-family: var(--sans);
			transition: all .12s;
			text-decoration: none;
			white-space: nowrap;
			line-height: 1.4;
		}

		.btn:hover { border-color: rgba(255,255,255,.2); color: var(--t1); background: var(--bg3); }
		.btn.primary { background: var(--green); color: #0a0a0b; border-color: transparent; font-weight: 600; }
		.btn.primary:hover { background: #34d399; }
		.btn.ghost { border-color: transparent; color: var(--t3); }
		.btn.ghost:hover { color: var(--t2); background: var(--bg3); border-color: var(--border); }
		.btn.danger { color: var(--red); border-color: var(--red-border); background: var(--red-bg); }
		.btn.danger:hover { background: rgba(248,113,113,.15); }
		.btn.warn { color: var(--yellow); border-color: var(--yellow-border); background: var(--yellow-bg); }
		.btn.warn:hover { background: rgba(251,191,36,.14); }
		.btn.disabled, .btn[disabled] { opacity: 0.35; cursor: default; pointer-events: none; }

		/* ── Content area ─────────────────────────────────── */
		.content {
			flex: 1;
			overflow-y: auto;
			padding: 20px 20px 60px;
		}

		@keyframes fadeIn {
			from { opacity: 0; transform: translateY(3px); }
			to { opacity: 1; transform: translateY(0); }
		}

		.content > * { animation: fadeIn 0.18s ease both; }

		/* ── Shared table ─────────────────────────────────── */
		.table-wrap {
			background: var(--bg2);
			border: 1px solid var(--border);
			border-radius: var(--r2);
			overflow: hidden;
			margin-bottom: 20px;
		}

		table { width: 100%; border-collapse: collapse; }
		thead tr { border-bottom: 1px solid var(--border); }
		thead th {
			padding: 9px 14px;
			text-align: left;
			font-size: 10px;
			font-weight: 500;
			color: var(--t3);
			text-transform: uppercase;
			letter-spacing: .06em;
			white-space: nowrap;
		}

		tbody tr.data-row {
			border-bottom: 1px solid var(--border);
			transition: background .1s;
			cursor: pointer;
		}

		tbody tr.data-row:last-child { border-bottom: none; }
		tbody tr.data-row:hover { background: var(--bg3); }

		td {
			padding: 11px 14px;
			font-size: 12px;
			vertical-align: middle;
		}

		.svc-name-link {
			font-family: var(--mono);
			font-size: 12px;
			color: var(--blue);
			text-decoration: none;
			display: block;
		}

		.svc-name-link:hover { text-decoration: underline; }

		.svc-url-small {
			font-family: var(--mono);
			font-size: 10px;
			color: var(--t3);
			display: block;
			margin-top: 2px;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			max-width: 200px;
		}

		.mono-val { font-family: var(--mono); font-size: 11px; }
		.c-green { color: var(--green); }
		.c-yellow { color: var(--yellow); }
		.c-red { color: var(--red); }
		.c-blue { color: var(--blue); }
		.c-t1 { color: var(--t1); }
		.c-t2 { color: var(--t2); }
		.c-t3 { color: var(--t3); }

		.td-actions { display: flex; gap: 5px; align-items: center; flex-wrap: wrap; }

		/* ── Chip ─────────────────────────────────────────── */
		.chip {
			font-size: 10px;
			padding: 2px 7px;
			border-radius: 4px;
			font-family: var(--mono);
			background: var(--bg4);
			color: var(--t2);
			border: 1px solid var(--border);
		}

		.chip.ok { background: var(--green-bg); color: var(--green); border-color: var(--green-border); }

		/* ── Card ─────────────────────────────────────────── */
		.card {
			background: var(--bg2);
			border: 1px solid var(--border);
			border-radius: var(--r2);
			padding: 16px;
		}

		.card-title {
			font-size: 10px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: .07em;
			color: var(--t3);
			margin-bottom: 12px;
		}

		/* ── KV row ───────────────────────────────────────── */
		.kv { display: flex; gap: 10px; margin-bottom: 8px; align-items: flex-start; }
		.kv:last-child { margin-bottom: 0; }
		.kk { font-size: 11px; color: var(--t3); width: 110px; min-width: 110px; padding-top: 1px; }
		.kv-val { font-size: 11px; color: var(--t1); font-family: var(--mono); word-break: break-all; }
		.kv-val.muted { color: var(--t3); font-size: 10px; }

		/* ── Alerts ───────────────────────────────────────── */
		@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }

		.pulse-dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: currentColor;
			flex-shrink: 0;
			animation: pulse 2s ease-in-out infinite;
		}

		/* ── Section header ───────────────────────────────── */
		.section-hdr {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 10px;
		}

		.section-title {
			font-size: 12px;
			font-weight: 600;
			color: var(--t1);
			text-transform: uppercase;
			letter-spacing: 0.06em;
		}

		/* ── Empty state ──────────────────────────────────── */
		.empty-state { padding: 40px 20px; text-align: center; }

		/* ── Code ─────────────────────────────────────────── */
		code {
			font-family: var(--mono);
			background: var(--bg4);
			padding: 1px 6px;
			border-radius: 4px;
			color: var(--t1);
			font-size: 0.9em;
		}

		/* ── HTMX ─────────────────────────────────────────── */
		.htmx-indicator { display: none; }
		.htmx-request .htmx-indicator { display: inline-block; }

		/* ── Danger zone ──────────────────────────────────── */
		.danger-zone {
			display: none;
			padding: 12px 16px;
			background: var(--red-bg);
			border-bottom: 1px solid var(--red-border);
			align-items: center;
			gap: 10px;
			font-size: 12px;
			color: var(--red);
			flex-shrink: 0;
		}

		.danger-zone.open { display: flex; }

		.confirm-wrap {
			display: none;
			padding: 10px 16px;
			background: rgba(248,113,113,.05);
			border-bottom: 1px solid var(--red-border);
			align-items: center;
			gap: 8px;
			font-size: 12px;
			color: var(--red);
			flex-shrink: 0;
		}

		.confirm-wrap.open { display: flex; }

		/* ── Dropdown ─────────────────────────────────────── */
		.dropdown-wrap { position: relative; display: inline-flex; }

		.dropdown-panel {
			display: none;
			position: absolute;
			top: calc(100% + 4px);
			right: 0;
			background: var(--bg3);
			border: 1px solid var(--border2);
			border-radius: var(--r);
			padding: 4px;
			z-index: 200;
			min-width: 180px;
			flex-direction: column;
			gap: 3px;
		}

		.dropdown-panel.open { display: flex; }
		.dropdown-panel .btn { width: 100%; justify-content: flex-start; }

		/* ── Inline confirm row (services table) ──────────── */
		.inline-confirm {
			display: none;
			margin-top: 6px;
			padding: 8px 10px;
			background: rgba(248,113,113,.05);
			border: 1px solid var(--red-border);
			border-radius: var(--r);
			align-items: center;
			gap: 8px;
			font-size: 12px;
			color: var(--red);
		}

		.inline-confirm.open { display: flex; }
	</style>
</head>

<body>
<div class="app">

	<!-- ── Sidebar ─────────────────────────────── -->
	<aside class="sidebar">
		<div class="sidebar-logo">
			<div class="logo-mark">A</div>
			<span class="logo-name">ADVNCD</span>
		</div>

		<nav class="sidebar-nav">
			<div class="nav-section-label">Dashboard</div>

			if active == "overview" {
				<a href="/" class="nav-item active">
					@navIconGrid()
					Overview
				</a>
			} else {
				<a href="/" class="nav-item">
					@navIconGrid()
					Overview
				</a>
			}

			if active == "services" {
				<a href="/services" class="nav-item active">
					@navIconList()
					Services
					if lctx.ServiceCount >= 0 {
						<span class="nav-badge">{itoa(lctx.ServiceCount)}</span>
					}
				</a>
			} else {
				<a href="/services" class="nav-item">
					@navIconList()
					Services
					if lctx.ServiceCount >= 0 {
						<span class="nav-badge">{itoa(lctx.ServiceCount)}</span>
					}
				</a>
			}

			<div class="nav-section-label">Observability</div>

			<a href="#" class="nav-item">
				@navIconBar()
				Metrics
			</a>

			<a href="#" class="nav-item">
				@navIconDoc()
				Logs
			</a>

			<div class="nav-section-label">Cloud</div>

			<a href="https://console.cloud.google.com/run" target="_blank" rel="noopener" class="nav-item">
				@navIconCloud()
				GCP Console
				<span class="nav-ext">↗</span>
			</a>
		</nav>

		<div class="sidebar-footer">
			<div class="footer-row">
				if lctx.ProjectID != "" && lctx.ProjectID != "-" {
					<div class="footer-dot" style="background:var(--green)"></div>
				} else {
					<div class="footer-dot" style="background:var(--t3)"></div>
				}
				<span class="footer-label">project</span>
				<span class="footer-val" title={lctx.ProjectID}>{lctx.ProjectID}</span>
			</div>
			<div class="footer-row">
				<div class="footer-dot" style="background:var(--blue)"></div>
				<span class="footer-label">region</span>
				<span class="footer-val">{lctx.Region}</span>
			</div>
			<div class="footer-row">
				if lctx.AuthStatus == "ok" {
					<div class="footer-dot" style="background:var(--green)"></div>
				} else {
					<div class="footer-dot" style="background:var(--t3)"></div>
				}
				<span class="footer-label">auth</span>
				<span class="footer-val" id="auth-timer">
					if lctx.TokenExpiresIn != "" && lctx.TokenExpiresIn != "-" {
						{lctx.TokenExpiresIn}
					} else {
						—
					}
				</span>
			</div>
		</div>
	</aside>

	<!-- ── Main ───────────────────────────────── -->
	<div class="main">

		<!-- Topbar -->
		<div class="topbar">
			<div class="breadcrumb">
				if crumbs != nil {
					for i, c := range crumbs {
						if i > 0 {
							<span class="bc-sep"> / </span>
						}
						if i == len(crumbs)-1 || c.Href == "" {
							<span class="bc-current">{c.Label}</span>
						} else {
							<a href={templ.URL(c.Href)} class="bc-parent">{c.Label}</a>
						}
					}
				}
			</div>
			<div class="topbar-right" id="topbar-right">
				<!-- page-specific actions injected here -->
			</div>
		</div>

		<!-- Danger zone strip (detail page) -->
		<div id="dz" class="danger-zone"></div>
		<div id="cw" class="confirm-wrap"></div>

		<!-- Page content -->
		<div class="content">
			@content
		</div>

	</div><!-- /main -->
</div><!-- /app -->

<script>
// ── Auth timer countdown ───────────────────────────────────
(function() {
  const meta = document.querySelector('meta[name="token-expires-in"]');
  const el = document.getElementById('auth-timer');
  if (!meta || !el) return;
  const val = meta.content;
  if (!val || val === '-' || val === '—') return;

  let secs = 0;
  const hm = val.match(/(\d+)h/); if (hm) secs += parseInt(hm[1]) * 3600;
  const mm = val.match(/(\d+)m/); if (mm) secs += parseInt(mm[1]) * 60;
  const sm = val.match(/(\d+(?:\.\d+)?)s/); if (sm) secs += parseFloat(sm[1]);
  secs = Math.round(secs);
  if (!secs) return;

  function fmt() {
    const m = Math.floor(secs / 60), s = secs % 60;
    el.textContent = m + 'm ' + String(s).padStart(2, '0') + 's';
    el.style.color = secs < 300 ? 'var(--yellow)' : '';
  }
  fmt();
  const tid = setInterval(() => {
    secs = Math.max(0, secs - 1);
    fmt();
    if (secs === 0) clearInterval(tid);
  }, 1000);
})();

// ── Clock (used by overview) ───────────────────────────────
(function() {
  const el = document.getElementById('clock-display');
  if (!el) return;
  function tick() { el.textContent = new Date().toTimeString().slice(0, 8); }
  tick();
  setInterval(tick, 1000);
})();

// ── Danger zone (detail page) ──────────────────────────────
function toggleDanger() {
  document.getElementById('dz').classList.toggle('open');
  if (!document.getElementById('dz').classList.contains('open')) {
    document.getElementById('cw').classList.remove('open');
  }
}

function showDangerConfirm() {
  document.getElementById('cw').classList.add('open');
}

function hideDangerConfirm() {
  document.getElementById('cw').classList.remove('open');
}

function closeDanger() {
  document.getElementById('dz').classList.remove('open');
  document.getElementById('cw').classList.remove('open');
}

// ── Dropdown menus (services table) ───────────────────────
function toggleDropdown(id, e) {
  e.stopPropagation();
  const panel = document.getElementById(id);
  const wasOpen = panel.classList.contains('open');
  closeAllDropdowns();
  if (!wasOpen) panel.classList.add('open');
}

function closeAllDropdowns() {
  document.querySelectorAll('.dropdown-panel').forEach(p => p.classList.remove('open'));
}

document.addEventListener('click', closeAllDropdowns);

// ── Inline confirm (services table) ───────────────────────
function showInlineConfirm(id) {
  document.getElementById(id).classList.add('open');
}

function hideInlineConfirm(id) {
  document.getElementById(id).classList.remove('open');
}
</script>
</body>
<script src="/static/explain.js"></script>
</html>
}

templ navIconGrid() {
	<svg width="14" height="14" viewBox="0 0 14 14" fill="none">
		<rect x="1" y="1" width="5" height="5" rx="1" fill="currentColor"/>
		<rect x="8" y="1" width="5" height="5" rx="1" fill="currentColor"/>
		<rect x="1" y="8" width="5" height="5" rx="1" fill="currentColor"/>
		<rect x="8" y="8" width="5" height="5" rx="1" fill="currentColor"/>
	</svg>
