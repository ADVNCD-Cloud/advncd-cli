package views

import "time"

type ConditionVM struct {
	Type  string
	State string
}

type InsightItemVM struct {
	Label       string
	Value       string
	Status      string
	Desc        string
	ActionLabel string
}

type InsightBadgeVM struct {
	Label    string
	Severity string
}

type ChartSeriesVM struct {
	Title      string
	LinePath   string
	AreaPath   string
	Stroke     string
	Fill       string
	RangeLabel string
	LastLabel  string
	Empty      bool
}

type ServiceDetailVM struct {
	Error string
	Now   time.Time

	Name             string
	Project          string
	Region           string
	SourceType       string
	RuntimeStatus    string
	LastRevision     string
	DeploymentID     string
	SourcePathOptional string
	PresetIDOptional string

	URL    string
	Image  string
	Memory string

	Conditions []ConditionVM

	ConsoleURL string

	// Logs
	LogsURL1h  string
	LogsURL6h  string
	LogsURL24h string
	LogsURLErr string
	LogsQuery  string

	// Metrics
	MetricsURL1h  string
	MetricsURL6h  string
	MetricsURL24h string

	RedeployURL string
	DeleteURL   string
	DisableURL  string

	AuthStatus string
	AuthHint   string

	ExplainText string

	SafetyProfile        string
	SafetyChecks         []InsightItemVM
	SafetyInterpretation string
	TrafficItems         []InsightItemVM
	ObservabilityCharts  []ChartSeriesVM
	CostItems            []InsightItemVM
	Anomalies            []InsightBadgeVM
}

templ ServiceDetail(vm ServiceDetailVM) {
<div class="max-w-5xl">

	<!-- Header -->
	<div class="flex items-start justify-between gap-4">
		<div>
			<h1 class="text-2xl font-semibold" style="color:#ffffff;">
				<span class="font-mono" style="color:#00d2ff;">{vm.Name}</span>
			</h1>
			<p class="mt-1 text-sm" style="color:#8b7fa8;">
				<span class="font-mono" style="color:#b0f0ff;">{vm.Project}</span>
				<span style="margin:0 0.4rem;opacity:0.4;">·</span>
				<span class="font-mono" style="color:#b0f0ff;">{vm.Region}</span>
			</p>
		</div>

		<div class="flex gap-2 flex-wrap justify-end">
			if vm.URL != "" {
				<a class="btn btn-sm btn-outline" href={vm.URL} target="_blank" rel="noopener">Open ↗</a>
			}
			if vm.AuthStatus == "ok" && vm.LogsURL1h != "" {
				<a class="btn btn-sm btn-ghost" href={vm.LogsURL1h} target="_blank" rel="noopener">Logs ↗</a>
			} else {
				<button class="btn btn-sm btn-ghost btn-disabled" type="button" title={vm.AuthHint}>Logs ↗</button>
			}
			if vm.AuthStatus == "ok" && vm.MetricsURL1h != "" {
				<a class="btn btn-sm btn-ghost" href={vm.MetricsURL1h} target="_blank" rel="noopener">Metrics ↗</a>
			} else {
				<button class="btn btn-sm btn-ghost btn-disabled" type="button" title={vm.AuthHint}>Metrics ↗</button>
			}
			if vm.ConsoleURL != "" {
				<a class="btn btn-sm btn-ghost" href={vm.ConsoleURL} target="_blank" rel="noopener">Console ↗</a>
			}
			if vm.RedeployURL != "" {
				<form method="post" action={vm.RedeployURL}>
					<input type="hidden" name="return_to" value={"/services/" + vm.Name} />
					<button class="btn btn-sm btn-ghost" type="submit">Redeploy</button>
				</form>
			}
			if vm.DeleteURL != "" {
				<form method="post" action={vm.DeleteURL} onsubmit="return confirm('Delete this service?');">
					<input type="hidden" name="return_to" value="/services" />
					<button class="btn btn-sm btn-error btn-outline" type="submit">Delete</button>
				</form>
			}
			if vm.DisableURL != "" {
				<form method="post" action={vm.DisableURL} onsubmit="return confirm('Disable public traffic?');">
					<input type="hidden" name="return_to" value={"/services/" + vm.Name} />
					<button class="btn btn-sm btn-warning btn-outline" type="submit">Disable Public</button>
				</form>
			}
			<button
				class="btn btn-sm btn-outline"
				type="button"
				data-explain-start
				data-service-name={vm.Name}
			>
				Explain
			</button>
		</div>
	</div>

	if vm.Error != "" {
		<div class="alert alert-error mt-6">
			<span>{vm.Error}</span>
		</div>
	}

	if vm.Error == "" {

		<!-- Anomaly banner (only if anomalies exist) -->
		if len(vm.Anomalies) > 0 {
			<div class="mt-6 flex gap-2 flex-wrap items-center" style="padding:0.75rem 1rem;background:rgba(255,77,106,0.06);border:1px solid rgba(255,77,106,0.2);border-radius:8px;">
				<span style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;color:#8b7fa8;font-family:'SUSE Mono',monospace;margin-right:0.5rem;">Anomalies</span>
				for _, a := range vm.Anomalies {
					if a.Severity == "error" {
						<span class="badge badge-error">{a.Label}</span>
					} else if a.Severity == "warn" {
						<span class="badge badge-warning">{a.Label}</span>
					} else {
						<span class="badge badge-ghost">{a.Label}</span>
					}
				}
			</div>
		}

		<!-- Identity + Endpoint -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">

			<div class="card">
				<div class="card-body" style="padding:1.25rem;">
					<h2 class="card-title">Identity</h2>
					<div class="mt-3" style="display:flex;flex-direction:column;gap:0.75rem;">
						<div>
							<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;font-family:'SUSE Mono',monospace;">service</div>
							<div class="font-mono mt-1" style="font-size:0.85rem;color:#b0f0ff;">{vm.Name}</div>
						</div>
						if vm.SourceType != "" {
							<div>
								<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;font-family:'SUSE Mono',monospace;">source_type</div>
								<div class="font-mono mt-1" style="font-size:0.85rem;">{vm.SourceType}</div>
							</div>
						}
						<div>
							<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;font-family:'SUSE Mono',monospace;">status</div>
							<div class="mt-1">
								if vm.RuntimeStatus == "ready" {
									<span class="badge badge-success">ready</span>
								} else if vm.RuntimeStatus == "error" {
									<span class="badge badge-error">error</span>
								} else {
									<span class="badge badge-ghost">unknown</span>
								}
							</div>
						</div>
						if vm.LastRevision != "" {
							<div>
								<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;font-family:'SUSE Mono',monospace;">latest_revision</div>
								<div class="font-mono break-all mt-1" style="font-size:0.75rem;">{vm.LastRevision}</div>
							</div>
						}
						if vm.DeploymentID != "" {
							<div>
								<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;font-family:'SUSE Mono',monospace;">deployment_id</div>
								<div class="font-mono mt-1" style="font-size:0.75rem;color:#8b7fa8;">{vm.DeploymentID}</div>
							</div>
						}
						if vm.SourcePathOptional != "" {
							<div>
								<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;font-family:'SUSE Mono',monospace;">source_path</div>
								<div class="font-mono break-all mt-1" style="font-size:0.75rem;">{vm.SourcePathOptional}</div>
							</div>
						}
					</div>
				</div>
			</div>

			<div class="card">
				<div class="card-body" style="padding:1.25rem;">
					<h2 class="card-title">Endpoint</h2>
					<div class="mt-3" style="display:flex;flex-direction:column;gap:0.75rem;">
						<div>
							<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;font-family:'SUSE Mono',monospace;">URL</div>
							if vm.URL != "" {
								<a class="link break-all mt-1" href={vm.URL} target="_blank" rel="noopener" style="font-size:0.82rem;display:block;">{vm.URL}</a>
							} else {
								<span style="color:#8b7fa8;margin-top:0.25rem;display:block;">—</span>
							}
						</div>
						<div>
							<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;font-family:'SUSE Mono',monospace;">Image</div>
							if vm.Image != "" {
								<div class="font-mono break-all mt-1" style="font-size:0.75rem;color:#b0f0ff;">{vm.Image}</div>
							} else {
								<span style="color:#8b7fa8;margin-top:0.25rem;display:block;">—</span>
							}
						</div>
					</div>
				</div>
			</div>

		</div>

		<!-- Conditions + Explain -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">

			<div class="card">
				<div class="card-body" style="padding:1.25rem;">
					<h2 class="card-title">Conditions</h2>
					if vm.Conditions == nil || len(vm.Conditions) == 0 {
						<p class="mt-3 text-sm" style="color:#8b7fa8;">No conditions found.</p>
					} else {
						<div class="overflow-x-auto mt-3">
							<table class="table">
								<thead>
									<tr>
										<th>Type</th>
										<th>State</th>
									</tr>
								</thead>
								<tbody>
									for _, c := range vm.Conditions {
										<tr>
											<td class="font-mono" style="font-size:0.8rem;">{c.Type}</td>
											<td>
												if c.State == "CONDITION_SUCCEEDED" {
													<span class="badge badge-success">SUCCEEDED</span>
												} else if c.State == "CONDITION_FAILED" {
													<span class="badge badge-error">FAILED</span>
												} else {
													<span class="badge badge-ghost">{c.State}</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>

			@ExplainCard(vm)

		</div>

		<!-- Safety / Traffic / Cost -->
		<div class="card mt-4">
			<div class="card-body" style="padding:1.25rem;">
				<div class="flex items-center justify-between gap-2">
					<h2 class="card-title">Safety / Traffic / Cost</h2>
					if vm.SafetyProfile != "" {
						<span class="badge badge-ghost">{vm.SafetyProfile}</span>
					}
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-4">

					<!-- Safety -->
					<div>
						<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;font-family:'SUSE Mono',monospace;margin-bottom:0.75rem;">Safety Checks</div>
						<div style="display:flex;flex-direction:column;gap:0.65rem;">
							for _, it := range vm.SafetyChecks {
								<div>
									<div style="font-size:0.8rem;color:#e8e0f0;font-weight:500;">{it.Label}</div>
									<div class="flex items-center gap-2 mt-1">
										if it.Status == "good" {
											<span class="badge badge-success">good</span>
										} else if it.Status == "caution" {
											<span class="badge badge-warning">caution</span>
										} else if it.Status == "danger" {
											<span class="badge badge-error">danger</span>
										} else {
											<span class="badge badge-ghost">info</span>
										}
										<span style="font-size:0.78rem;color:#8b7fa8;">{it.Value}</span>
									</div>
								</div>
							}
							if vm.SafetyInterpretation != "" {
								<div style="font-size:0.75rem;color:#8b7fa8;margin-top:0.25rem;">{vm.SafetyInterpretation}</div>
							}
						</div>
					</div>

					<!-- Traffic -->
					<div>
						<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;font-family:'SUSE Mono',monospace;margin-bottom:0.75rem;">Traffic (near-live)</div>
						<div style="display:flex;flex-direction:column;gap:0.65rem;">
							for _, it := range vm.TrafficItems {
								<div>
									<div style="font-size:0.8rem;color:#e8e0f0;font-weight:500;">{it.Label}</div>
									<div class="flex items-center gap-2 mt-1">
										if it.Status == "good" {
											<span class="badge badge-success">good</span>
										} else if it.Status == "caution" {
											<span class="badge badge-warning">caution</span>
										} else if it.Status == "danger" {
											<span class="badge badge-error">danger</span>
										} else if it.Status == "info" {
											<span class="badge badge-info">info</span>
										}
										<span style="font-size:0.78rem;color:#8b7fa8;">{it.Value}</span>
									</div>
								</div>
							}
						</div>
					</div>

					<!-- Cost -->
					<div>
						<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;font-family:'SUSE Mono',monospace;margin-bottom:0.75rem;">Cost Visibility</div>
						<div style="font-size:0.72rem;color:#8b7fa8;margin-bottom:0.5rem;">Directional estimate. Falls back to request+latency assumptions if live metrics unavailable.</div>
						<div style="display:flex;flex-direction:column;gap:0.65rem;">
							for _, it := range vm.CostItems {
								<div>
									<div style="font-size:0.8rem;color:#e8e0f0;font-weight:500;">{it.Label}</div>
									<div style="font-size:0.82rem;color:#00d2ff;font-family:'SUSE Mono',monospace;margin-top:0.15rem;">{it.Value}</div>
								</div>
							}
						</div>
					</div>

				</div>
			</div>
		</div>

		<!-- Observability -->
		<div class="card mt-4">
			<div class="card-body" style="padding:1.25rem;">
				<h2 class="card-title">Observability</h2>

				<div style="margin-top:1rem;display:flex;flex-direction:column;gap:1rem;">
					<div>
						<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;font-family:'SUSE Mono',monospace;margin-bottom:0.5rem;">Charts (last 1h)</div>
						if len(vm.ObservabilityCharts) == 0 {
							<div style="font-size:0.82rem;color:#8b7fa8;">No chart data yet. Wait for monitoring points or check Metrics.</div>
						} else {
							<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
								for _, ch := range vm.ObservabilityCharts {
									<div style="padding:0.6rem;border:1px solid rgba(255,255,255,0.08);border-radius:8px;background:rgba(16,22,35,0.55);">
										<div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
											<div style="font-size:0.78rem;color:#e8e0f0;font-weight:500;">{ch.Title}</div>
											if ch.Empty {
												<span class="badge badge-ghost">no data</span>
											}
										</div>
										if !ch.Empty {
											<svg viewBox="0 0 220 64" style="width:100%;height:76px;display:block;margin-top:0.35rem;">
												<path d={ch.AreaPath} fill={ch.Fill}></path>
												<path d={ch.LinePath} fill="none" stroke={ch.Stroke} stroke-width="2"></path>
											</svg>
											<div style="display:flex;justify-content:space-between;gap:0.5rem;margin-top:0.2rem;">
												<span style="font-size:0.72rem;color:#8b7fa8;">range {ch.RangeLabel}</span>
												<span style="font-size:0.72rem;color:#b0f0ff;">now {ch.LastLabel}</span>
											</div>
										}
									</div>
								}
							</div>
						}
					</div>

					<div>
						<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;font-family:'SUSE Mono',monospace;margin-bottom:0.5rem;">Logs</div>
						<div class="flex gap-2 flex-wrap">
							<a class="btn btn-xs btn-outline" href={vm.LogsURL1h} target="_blank" rel="noopener">Last 1h</a>
							<a class="btn btn-xs btn-outline" href={vm.LogsURL6h} target="_blank" rel="noopener">Last 6h</a>
							<a class="btn btn-xs btn-outline" href={vm.LogsURL24h} target="_blank" rel="noopener">Last 24h</a>
							<a class="btn btn-xs btn-outline" href={vm.LogsURLErr} target="_blank" rel="noopener">Errors (1h)</a>
							<button
								class="btn btn-xs btn-ghost"
								type="button"
								id="copy-logs-query"
								data-query={vm.LogsQuery}
							>
								Copy query
							</button>
							<script>
								document.addEventListener("click", async (e) => {
								const btn = e.target.closest("#copy-logs-query");
								if (!btn) return;
								const q = btn.getAttribute("data-query") || "";
								if (!q) return;
								try {
									await navigator.clipboard.writeText(q);
									const prev = btn.textContent;
									btn.textContent = "Copied ✓";
									setTimeout(() => { btn.textContent = prev; }, 1500);
								} catch (_) {}
								});
							</script>
						</div>
					</div>

					<div>
						<div style="color:#8b7fa8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;font-family:'SUSE Mono',monospace;margin-bottom:0.5rem;">Metrics</div>
						<div class="flex gap-2 flex-wrap">
							if vm.AuthStatus == "ok" {
								<a class="btn btn-xs btn-outline" href={vm.MetricsURL1h} target="_blank" rel="noopener">Last 1h</a>
								<a class="btn btn-xs btn-outline" href={vm.MetricsURL6h} target="_blank" rel="noopener">Last 6h</a>
								<a class="btn btn-xs btn-outline" href={vm.MetricsURL24h} target="_blank" rel="noopener">Last 24h</a>
							} else {
								<button class="btn btn-xs btn-outline btn-disabled" type="button" title={vm.AuthHint}>Last 1h</button>
								<button class="btn btn-xs btn-outline btn-disabled" type="button" title={vm.AuthHint}>Last 6h</button>
								<button class="btn btn-xs btn-outline btn-disabled" type="button" title={vm.AuthHint}>Last 24h</button>
							}
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="mt-5">
			<a class="link" href="/services">← Back to services</a>
		</div>

		<div class="mt-4" style="font-size:0.72rem;color:#8b7fa8;font-family:'SUSE Mono',monospace;">
			rendered { vm.Now.Format("2006-01-02 15:04:05") }
		</div>

	}
</div>
}

templ ExplainCard(vm ServiceDetailVM) {
	<div id="explain-card" class="card">
		<div class="card-body" style="padding:1.25rem;">
			<div id="explain-status" style="font-size:0.72rem;color:#8b7fa8;font-family:'SUSE Mono',monospace;margin-bottom:0.25rem;"></div>
			<div class="flex items-start justify-between gap-2">
				<h2 class="card-title flex items-center gap-2">
					Explain
					<span id="explain-loading" class="loading loading-spinner loading-sm htmx-indicator"></span>
				</h2>
				if vm.Name != "" {
					if vm.ExplainText != "" {
						<a
							class="btn btn-xs btn-ghost"
							hx-get={"/services/" + vm.Name + "/explain?clear=1"}
							hx-target="#explain-card"
							hx-swap="outerHTML"
						>
							Clear
						</a>
					}
				}
			</div>
			if vm.ExplainText == "" {
				<p class="mt-2" style="font-size:0.82rem;color:#8b7fa8;" data-explain-hint>
					Click "Explain" to get an LLM explanation of the current service conditions.
				</p>
			} else {
				<pre class="whitespace-pre-wrap" style="font-size:0.82rem;margin-top:0.5rem;">{vm.ExplainText}</pre>
			}
		</div>
	</div>
}
