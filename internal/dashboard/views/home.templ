package views

import "time"

type HomeServiceRowVM struct {
	Name        string
	SourceType  string
	Status      string
	URL         string
	UpdatedText string
	DetailHref  string
	LogsURL     string
	MetricsURL  string
	RedeployURL string
	DeleteURL   string
	DisableURL  string
}

type HomeVM struct {
	Error string
	Now   time.Time

	// Auth
	AuthStatus     string // ok / missing / expired
	AuthHint       string
	Email          string
	TokenExpiresIn string
	CredsPath      string

	// Context
	ProjectStatus string // ok / missing
	ProjectHint   string
	ProjectID     string
	Region        string
	ConfigPath    string

	// Services summary
	ServicesTotal  int
	ServicesReady  int
	ServicesIssues int

	Services []HomeServiceRowVM

	RecentProjects []string
	RecentRegions  []string
}

templ Home(vm HomeVM) {
<div class="max-w-6xl">

	<div class="flex items-start justify-between gap-4">
		<div>
			<h1 class="text-2xl font-semibold">Overview</h1>
			<p class="text-base-content/70 mt-1">Snapshot of your current Cloud Run context.</p>
		</div>

		<div class="flex gap-2 flex-wrap justify-end">
			<a class="btn btn-sm btn-outline" href="/services">Services</a>
			<a class="btn btn-sm btn-outline" href="/deploy-local">Deploy Local Project</a>
			<a class="btn btn-sm btn-ghost" href="https://console.cloud.google.com/run" target="_blank" rel="noopener">GCP Console ↗</a>
			<button class="btn btn-sm btn-ghost" type="button" id="copy-publish">Copy: advncd publish</button>
			<button class="btn btn-sm btn-ghost" type="button" id="copy-launch">Copy: advncd launch n8n</button>
		</div>
	</div>

	<script>
document.addEventListener("click", async (e) => {
  const btn = e.target.closest("#copy-publish");
  if (!btn) return;
  try {
    await navigator.clipboard.writeText("advncd publish");
    const prev = btn.textContent;
    btn.textContent = "Copied ✓";
    setTimeout(() => { btn.textContent = prev; }, 1500);
  } catch (_) {}
});
document.addEventListener("click", async (e) => {
  const btn = e.target.closest("#copy-launch");
  if (!btn) return;
  try {
    await navigator.clipboard.writeText("advncd launch n8n");
    const prev = btn.textContent;
    btn.textContent = "Copied ✓";
    setTimeout(() => { btn.textContent = prev; }, 1500);
  } catch (_) {}
});
	</script>

	if vm.Error != "" {
		<div class="alert alert-error mt-6">
			<span>{vm.Error}</span>
		</div>
	}

	<!-- Stat cards -->
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<div class="flex items-center justify-between">
					<h2 class="card-title text-base">Auth</h2>
					if vm.AuthStatus == "ok" {
						<span class="badge badge-success">ok</span>
					} else if vm.AuthStatus == "expired" {
						<span class="badge badge-warning">expired</span>
					} else {
						<span class="badge badge-error">missing</span>
					}
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">email</div>
					<div class="font-medium break-all">{vm.Email}</div>
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">token_expires_in</div>
					<div class="font-mono">{vm.TokenExpiresIn}</div>
				</div>

				if vm.AuthHint != "" {
					<div class="mt-3 text-xs text-base-content/60">{vm.AuthHint}</div>
				}
			</div>
		</div>

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<div class="flex items-center justify-between">
					<h2 class="card-title text-base">Context</h2>
					if vm.ProjectStatus == "ok" {
						<span class="badge badge-success">set</span>
					} else {
						<span class="badge badge-error">missing</span>
					}
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">project</div>
					<div class="font-medium break-all">{vm.ProjectID}</div>
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">region</div>
					<div class="font-mono">{vm.Region}</div>
				</div>

				if vm.ProjectHint != "" {
					<div class="mt-3 text-xs text-base-content/60">{vm.ProjectHint}</div>
				}
			</div>
		</div>

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<div class="flex items-center justify-between">
					<h2 class="card-title text-base">Services</h2>
					<span class="badge badge-neutral">{itoa(vm.ServicesTotal)}</span>
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">ready</div>
					<div class="text-3xl font-semibold">{itoa(vm.ServicesReady)}</div>
				</div>

				<div class="mt-3 text-xs text-base-content/60">
					<a class="link" href="/services">View all →</a>
				</div>
			</div>
		</div>

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<div class="flex items-center justify-between">
					<h2 class="card-title text-base">Issues</h2>
					if vm.ServicesIssues > 0 {
						<span class="badge badge-warning">{itoa(vm.ServicesIssues)}</span>
					} else {
						<span class="badge badge-success">0</span>
					}
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">not ready</div>
					<div class="text-3xl font-semibold">{itoa(vm.ServicesIssues)}</div>
				</div>

				<div class="mt-3 text-xs text-base-content/60">
					Open a service and check Logs / Metrics.
				</div>
			</div>
		</div>

	</div>

	<!-- Services table -->
	<div class="card bg-base-100 shadow mt-6">
		<div class="card-body">
			<div class="flex items-center justify-between">
				<h2 class="card-title">Services</h2>
				<a class="btn btn-sm btn-outline" href="/services">Open list</a>
			</div>

			if vm.Services == nil || len(vm.Services) == 0 {
				<div class="mt-4 text-sm text-base-content/70">
					No services found. Deploy one with <span class="font-mono">advncd deploy</span> or open <a class="link" href="/deploy-local">Deploy Local Project</a>.
				</div>
			} else {
				<div class="overflow-x-auto mt-4">
					<table class="table table-zebra">
						<thead>
							<tr>
								<th>Name</th>
								<th>Source</th>
								<th>Status</th>
								<th>URL</th>
								<th>Updated</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, s := range vm.Services {
								<tr>
									<td>
										<a class="link font-mono" href={s.DetailHref}>{s.Name}</a>
									</td>
									<td>
										if s.SourceType == "" {
											<span class="text-base-content/50">—</span>
										} else {
											<span class="badge badge-ghost">{s.SourceType}</span>
										}
									</td>
									<td>
										if s.Status == "ready" {
											<span class="badge badge-success">ready</span>
										} else if s.Status == "error" {
											<span class="badge badge-error">error</span>
										} else {
											<span class="badge badge-ghost">unknown</span>
										}
									</td>
									<td class="truncate max-w-xs">
										if s.URL != "" {
											<a class="link" href={s.URL} target="_blank" rel="noopener">{s.URL}</a>
										} else {
											<span class="text-base-content/50">—</span>
										}
									</td>
									<td class="text-xs text-base-content/70">{s.UpdatedText}</td>
									<td class="text-right">
										<div class="flex gap-2 flex-wrap justify-end">
											if s.URL != "" {
												<a class="btn btn-xs" href={s.URL} target="_blank" rel="noopener">Open</a>
											}
											if s.LogsURL != "" {
												<a class="btn btn-xs btn-outline" href={s.LogsURL} target="_blank" rel="noopener">Logs</a>
											}
											if s.MetricsURL != "" {
												<a class="btn btn-xs btn-outline" href={s.MetricsURL} target="_blank" rel="noopener">Metrics</a>
											}
											<form method="post" action={s.RedeployURL}>
												<input type="hidden" name="return_to" value="/" />
												<button class="btn btn-xs btn-ghost" type="submit">Redeploy</button>
											</form>
											<form method="post" action={s.DeleteURL} onsubmit="return confirm('Delete this service?');">
												<input type="hidden" name="return_to" value="/" />
												<button class="btn btn-xs btn-error btn-outline" type="submit">Delete</button>
											</form>
											<form method="post" action={s.DisableURL} onsubmit="return confirm('Disable public traffic for this service?');">
												<input type="hidden" name="return_to" value="/" />
												<button class="btn btn-xs btn-warning btn-outline" type="submit">Disable Public</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				<div class="mt-3">
					<a class="link" href="/services">View all services →</a>
				</div>
			}

			<div class="mt-6 text-xs text-base-content/50">
				Rendered at {vm.Now.Format("2006-01-02 15:04:05")}
			</div>
		</div>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-6">
		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<h2 class="card-title">Context Management</h2>
				<p class="text-sm text-base-content/70">Current execution context plus recent choices from local registry.</p>
				<div class="mt-3 text-sm">
					<div><span class="text-base-content/60">account:</span> <span class="font-medium">{vm.Email}</span></div>
					<div><span class="text-base-content/60">project:</span> <span class="font-mono">{vm.ProjectID}</span></div>
					<div><span class="text-base-content/60">region:</span> <span class="font-mono">{vm.Region}</span></div>
				</div>
				<div class="mt-3 text-sm">
					<div class="text-base-content/60">recent projects</div>
					if len(vm.RecentProjects) == 0 {
						<div class="text-base-content/50">—</div>
					} else {
						<div class="flex gap-2 flex-wrap">
							for _, p := range vm.RecentProjects {
								<span class="badge badge-ghost">{p}</span>
							}
						</div>
					}
				</div>
				<div class="mt-3 text-sm">
					<div class="text-base-content/60">recent regions</div>
					if len(vm.RecentRegions) == 0 {
						<div class="text-base-content/50">—</div>
					} else {
						<div class="flex gap-2 flex-wrap">
							for _, rg := range vm.RecentRegions {
								<span class="badge badge-ghost">{rg}</span>
							}
						</div>
					}
				</div>
				<div class="mt-4 text-xs text-base-content/60">To change defaults: <span class="font-mono">advncd init</span></div>
			</div>
		</div>

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<h2 class="card-title">Launch Entry Points</h2>
				<p class="text-sm text-base-content/70">Quick bridge into deploy/launch flows.</p>
				<div class="mt-4 flex gap-2 flex-wrap">
					<a class="btn btn-sm btn-outline" href="/deploy-local">Deploy local project</a>
					<button class="btn btn-sm btn-ghost" type="button" id="copy-launch-inline">Copy: advncd launch n8n</button>
				</div>
				<div class="mt-4 text-xs text-base-content/60">
					Also available: <span class="font-mono">advncd launch n8n</span>
				</div>
			</div>
		</div>
	</div>

	<script>
document.addEventListener("click", async (e) => {
  const btn = e.target.closest("#copy-launch-inline");
  if (!btn) return;
  try {
    await navigator.clipboard.writeText("advncd launch n8n");
    const prev = btn.textContent;
    btn.textContent = "Copied ✓";
    setTimeout(() => { btn.textContent = prev; }, 1500);
  } catch (_) {}
});
	</script>

</div>
}
