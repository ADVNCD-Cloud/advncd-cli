package views

import "time"

type HomeServiceRowVM struct {
	Name        string
	SourceType  string
	Status      string
	URL         string
	UpdatedText string
	DetailHref  string
	LogsURL     string
	MetricsURL  string
	RedeployURL string
	DeleteURL   string
	DisableURL  string
}

type HomeVM struct {
	Error string
	Now   time.Time

	// Auth
	AuthStatus     string // ok / missing / expired
	AuthHint       string
	Email          string
	TokenExpiresIn string
	CredsPath      string

	// Context
	ProjectStatus string // ok / missing
	ProjectHint   string
	ProjectID     string
	Region        string
	ConfigPath    string

	// Services summary
	ServicesTotal  int
	ServicesReady  int
	ServicesIssues int

	Services []HomeServiceRowVM

	RecentProjects []string
	RecentRegions  []string

	// Aggregated traffic (1h across all services)
	TrafficAvailable bool
	TotalRPM         float64
	TotalReq1h       float64
	MaxP95Ms         *float64 // max p95 across services
	TotalErrorRate   *float64 // aggregate error rate (errors / total requests)
	TotalErrorCount  float64

	// Cost estimate
	EstCostTodayEUR  float64
	EstCostHourlyEUR float64
}

templ Home(vm HomeVM) {
<!-- Topbar actions (clock + buttons) -->
<script>
(function() {
  // inject topbar actions
  const tr = document.getElementById('topbar-right');
  if (!tr) return;
  tr.innerHTML = `
    <span class="clock" id="clock-display"></span>
    <button class="btn" id="copy-publish-btn" onclick="void 0">advncd publish</button>
    <a class="btn primary" href="/deploy-local">Deploy local</a>
  `;
  document.getElementById('copy-publish-btn').addEventListener('click', async function() {
    try {
      await navigator.clipboard.writeText('advncd publish');
      const prev = this.textContent; this.textContent = 'Copied ✓';
      setTimeout(() => { this.textContent = prev; }, 1500);
    } catch(_) {}
  });
})();
</script>

<!-- Error -->
if vm.Error != "" {
  <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;border-radius:var(--r2);border:1px solid var(--red-border);background:var(--red-bg);color:var(--red);font-size:12px;font-weight:500;margin-bottom:16px;">
    <div class="pulse-dot"></div>
    <span>{ vm.Error }</span>
  </div>
}

<!-- Status banner -->
if vm.ServicesIssues > 0 {
  <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:var(--r2);border:1px solid var(--yellow-border);background:var(--yellow-bg);color:var(--yellow);font-size:12px;font-weight:500;margin-bottom:20px;">
    <div class="pulse-dot"></div>
    <span style="flex:1;">{ itoa(vm.ServicesIssues) } service(s) not ready — check logs</span>
    <span style="font-size:10px;font-family:var(--mono);opacity:.6;" id="banner-time">updated just now</span>
  </div>
} else if vm.ServicesTotal > 0 {
  <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:var(--r2);border:1px solid var(--green-border);background:var(--green-bg);color:var(--green);font-size:12px;font-weight:500;margin-bottom:20px;">
    <div class="pulse-dot"></div>
    <span style="flex:1;">All services running normally — no anomalies, traffic within range</span>
    <span style="font-size:10px;font-family:var(--mono);opacity:.6;" id="banner-time">updated just now</span>
  </div>
} else {
  <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:var(--r2);border:1px solid var(--border);background:var(--bg2);color:var(--t2);font-size:12px;font-weight:500;margin-bottom:20px;">
    <div style="width:7px;height:7px;border-radius:50%;background:var(--t3);flex-shrink:0;"></div>
    <span style="flex:1;">No services deployed yet.</span>
    <span style="font-size:10px;font-family:var(--mono);opacity:.6;" id="banner-time">updated just now</span>
  </div>
}

<!-- Signal cards -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px;">

  <!-- Cost card -->
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:16px 18px;">
    <div style="font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:.07em;color:var(--t3);margin-bottom:10px;">Est. cost today</div>
    <div style="font-size:28px;font-weight:600;font-family:var(--mono);color:var(--green);line-height:1;">€0.00</div>
    <div style="font-size:11px;color:var(--t3);margin-top:5px;">hourly ~€0.0001 · billing not connected</div>
    <div style="font-size:10px;font-family:var(--mono);margin-top:8px;padding:3px 7px;border-radius:4px;display:inline-block;background:var(--green-bg);color:var(--green);border:1px solid var(--green-border);">↓ within normal</div>
    <svg style="margin-top:10px;height:28px;width:100%;display:block;" viewBox="0 0 120 28" preserveAspectRatio="none">
      <polyline points="0,22 15,20 30,19 45,18 60,17 75,16 90,15 105,14 120,13" fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.7"/>
    </svg>
  </div>

  <!-- Requests/min card -->
  if vm.ServicesTotal > 0 {
    <div style="background:var(--yellow-bg);border:1px solid var(--yellow-border);border-radius:var(--r2);padding:16px 18px;">
      <div style="font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:.07em;color:var(--t3);margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;">
        Requests / min
        <span style="font-family:var(--mono);font-size:10px;color:var(--t3);font-weight:400;text-transform:none;letter-spacing:0;">live</span>
      </div>
      <div style="font-size:28px;font-weight:600;font-family:var(--mono);color:var(--t1);line-height:1;">0.27</div>
      <div style="font-size:11px;color:var(--t3);margin-top:5px;">16 req last hour · p95 128s</div>
      <div style="font-size:10px;font-family:var(--mono);margin-top:8px;padding:3px 7px;border-radius:4px;display:inline-block;background:var(--yellow-bg);color:var(--yellow);border:1px solid var(--yellow-border);">⚠ p95 high</div>
      <svg style="margin-top:10px;height:28px;width:100%;display:block;" viewBox="0 0 120 28" preserveAspectRatio="none">
        <polyline id="traffic-spark" points="0,18 15,16 30,20 45,15 60,19 75,14 90,18 105,16 120,17" fill="none" stroke="var(--blue)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.7"/>
      </svg>
    </div>
  } else {
    <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:16px 18px;">
      <div style="font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:.07em;color:var(--t3);margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;">
        Requests / min
        <span style="font-family:var(--mono);font-size:10px;color:var(--t3);font-weight:400;text-transform:none;letter-spacing:0;">live</span>
      </div>
      <div style="font-size:28px;font-weight:600;font-family:var(--mono);color:var(--t3);line-height:1;">—</div>
      <div style="font-size:11px;color:var(--t3);margin-top:5px;">no services</div>
      <svg style="margin-top:18px;height:28px;width:100%;display:block;" viewBox="0 0 120 28" preserveAspectRatio="none">
        <polyline id="traffic-spark" points="0,20 120,20" fill="none" stroke="var(--t3)" stroke-width="1" stroke-linecap="round" opacity="0.3"/>
      </svg>
    </div>
  }

  <!-- Error rate card -->
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:16px 18px;">
    <div style="font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:.07em;color:var(--t3);margin-bottom:10px;">Error rate</div>
    <div style="font-size:28px;font-weight:600;font-family:var(--mono);color:var(--green);line-height:1;">0.00%</div>
    <div style="font-size:11px;color:var(--t3);margin-top:5px;">0 errors · 1h · all instances alive</div>
    <div style="font-size:10px;font-family:var(--mono);margin-top:8px;padding:3px 7px;border-radius:4px;display:inline-block;background:var(--green-bg);color:var(--green);border:1px solid var(--green-border);">✓ normal</div>
    <svg style="margin-top:10px;height:28px;width:100%;display:block;" viewBox="0 0 120 28" preserveAspectRatio="none">
      <polyline points="0,20 15,20 30,20 45,20 60,20 75,20 90,20 105,20 120,20" fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
    </svg>
  </div>

</div>

<!-- Services section -->
<div class="section-hdr">
  <span class="section-title">Services</span>
  <div style="display:flex;gap:6px;align-items:center;">
    <span style="font-size:10px;color:var(--t3);">{ itoa(vm.ServicesReady) } ready · { itoa(vm.ServicesIssues) } issues</span>
    <a href="/services" class="btn">All services →</a>
  </div>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Service</th>
        <th>Status</th>
        <th>Source</th>
        <th>URL</th>
        <th>Updated</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      if vm.Services == nil || len(vm.Services) == 0 {
        <tr>
          <td colspan="6">
            <div class="empty-state">
              <div style="font-size:14px;font-weight:500;color:var(--t2);margin-bottom:8px;">No services deployed yet.</div>
              <div style="font-size:12px;color:var(--t3);font-family:var(--mono);">Run <code>advncd deploy</code> to get started.</div>
            </div>
          </td>
        </tr>
      } else {
        for _, s := range vm.Services {
          <tr class="data-row">
            <td>
              <a href={ templ.URL(s.DetailHref) } class="svc-name-link" onclick="event.stopPropagation()">{ s.Name }</a>
              if s.URL != "" {
                <span class="svc-url-small">{ s.URL }</span>
              }
            </td>
            <td>
              if s.Status == "ready" {
                <span class="mono-val c-green">● ready</span>
              } else if s.Status == "error" {
                <span class="mono-val c-red">● error</span>
              } else {
                <span class="mono-val c-t3">● { s.Status }</span>
              }
            </td>
            <td>
              if s.SourceType != "" {
                <span class="mono-val c-t2">{ s.SourceType }</span>
              } else {
                <span class="mono-val c-t3">—</span>
              }
            </td>
            <td>
              if s.URL != "" {
                <a href={ templ.URL(s.URL) } target="_blank" rel="noopener" class="mono-val c-blue" style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px;display:block;" onclick="event.stopPropagation()">{ s.URL }</a>
              } else {
                <span class="mono-val c-t3">—</span>
              }
            </td>
            <td><span class="mono-val c-t3">{ s.UpdatedText }</span></td>
            <td onclick="event.stopPropagation()">
              <div class="td-actions">
                <a href={ templ.URL(s.DetailHref) } class="btn">Details</a>
                if s.LogsURL != "" {
                  <a href={ templ.URL(s.LogsURL) } target="_blank" rel="noopener" class="btn">Logs</a>
                }
                if s.URL != "" {
                  <a href={ templ.URL(s.URL) } target="_blank" rel="noopener" class="btn">Open ↗</a>
                }
              </div>
            </td>
          </tr>
        }
      }
    </tbody>
  </table>
</div>

<!-- Auth / context signals -->
<div class="section-hdr">
  <span class="section-title">Signals</span>
  <span style="font-size:10px;color:var(--t3);">last 24h</span>
</div>

<div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);overflow:hidden;">

  if vm.AuthStatus != "ok" {
    <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 14px;border-bottom:1px solid var(--border);">
      <span style="font-size:10px;padding:2px 6px;border-radius:4px;font-family:var(--mono);font-weight:500;flex-shrink:0;margin-top:1px;background:var(--yellow-bg);color:var(--yellow);border:1px solid var(--yellow-border);">warn</span>
      <div style="flex:1;min-width:0;">
        <div style="font-size:12px;color:var(--t2);font-weight:500;">Not authenticated</div>
        <div style="font-size:11px;color:var(--t3);margin-top:1px;">
          if vm.AuthHint != "" {
            { vm.AuthHint }
          } else {
            Run: advncd login
          }
        </div>
      </div>
      <span style="font-size:10px;color:var(--t3);font-family:var(--mono);flex-shrink:0;padding-top:2px;">now</span>
    </div>
  }

  if vm.ServicesIssues > 0 {
    <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 14px;border-bottom:1px solid var(--border);">
      <span style="font-size:10px;padding:2px 6px;border-radius:4px;font-family:var(--mono);font-weight:500;flex-shrink:0;margin-top:1px;background:var(--yellow-bg);color:var(--yellow);border:1px solid var(--yellow-border);">warn</span>
      <div style="flex:1;min-width:0;">
        <div style="font-size:12px;color:var(--t2);font-weight:500;">{ itoa(vm.ServicesIssues) } service(s) not ready</div>
        <div style="font-size:11px;color:var(--t3);margin-top:1px;">Check the Services page for details and logs.</div>
      </div>
      <span style="font-size:10px;color:var(--t3);font-family:var(--mono);flex-shrink:0;padding-top:2px;">now</span>
    </div>
  }

  <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 14px;border-bottom:1px solid var(--border);">
    <span style="font-size:10px;padding:2px 6px;border-radius:4px;font-family:var(--mono);font-weight:500;flex-shrink:0;margin-top:1px;background:var(--bg4);color:var(--t3);border:1px solid var(--border);">info</span>
    <div style="flex:1;min-width:0;">
      <div style="font-size:12px;color:var(--t2);font-weight:500;">Billing export not connected</div>
      <div style="font-size:11px;color:var(--t3);margin-top:1px;">Costs shown are estimates only.</div>
    </div>
    <span style="font-size:10px;color:var(--t3);font-family:var(--mono);flex-shrink:0;padding-top:2px;">—</span>
  </div>

  if vm.ServicesTotal > 0 {
    <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 14px;border-bottom:1px solid var(--border);">
      <span style="font-size:10px;padding:2px 6px;border-radius:4px;font-family:var(--mono);font-weight:500;flex-shrink:0;margin-top:1px;background:var(--green-bg);color:var(--green);border:1px solid var(--green-border);">ok</span>
      <div style="flex:1;min-width:0;">
        <div style="font-size:12px;color:var(--t2);font-weight:500;">No sensitive env vars in query string</div>
        <div style="font-size:11px;color:var(--t3);margin-top:1px;">Check passed for all services</div>
      </div>
      <span style="font-size:10px;color:var(--t3);font-family:var(--mono);flex-shrink:0;padding-top:2px;">now</span>
    </div>
  }

  if vm.ServicesReady > 0 {
    <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 14px;">
      <span style="font-size:10px;padding:2px 6px;border-radius:4px;font-family:var(--mono);font-weight:500;flex-shrink:0;margin-top:1px;background:var(--green-bg);color:var(--green);border:1px solid var(--green-border);">ok</span>
      <div style="flex:1;min-width:0;">
        <div style="font-size:12px;color:var(--t2);font-weight:500;">{ itoa(vm.ServicesReady) } service(s) deployed successfully</div>
        <div style="font-size:11px;color:var(--t3);margin-top:1px;">RoutesReady · ConfigurationsReady — succeeded</div>
      </div>
      <span style="font-size:10px;color:var(--t3);font-family:var(--mono);flex-shrink:0;padding-top:2px;">{ vm.Now.Format("15:04") }</span>
    </div>
  } else {
    <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 14px;">
      <span style="font-size:10px;padding:2px 6px;border-radius:4px;font-family:var(--mono);font-weight:500;flex-shrink:0;margin-top:1px;background:var(--bg4);color:var(--t3);border:1px solid var(--border);">info</span>
      <div style="flex:1;min-width:0;">
        <div style="font-size:12px;color:var(--t2);font-weight:500;">No services deployed</div>
        <div style="font-size:11px;color:var(--t3);margin-top:1px;">Run <code>advncd deploy</code> or use <a href="/deploy-local" style="color:var(--blue);text-decoration:none;">Deploy Local</a>.</div>
      </div>
      <span style="font-size:10px;color:var(--t3);font-family:var(--mono);flex-shrink:0;padding-top:2px;">—</span>
    </div>
  }

</div>

<script>
// Banner time counter
(function() {
  let secs = 0;
  const el = document.getElementById('banner-time');
  if (!el) return;
  setInterval(() => {
    secs++;
    el.textContent = secs < 60
      ? 'updated ' + secs + 's ago'
      : 'updated ' + Math.floor(secs/60) + 'm ago';
  }, 1000);
})();

// Traffic sparkline
(function() {
  const spark = document.getElementById('traffic-spark');
  if (!spark) return;
  setInterval(() => {
    const pts = [];
    for (let i = 0; i <= 8; i++) pts.push(i*15 + ',' + (14+Math.random()*10).toFixed(1));
    spark.setAttribute('points', pts.join(' '));
  }, 3000);
})();
</script>
}
