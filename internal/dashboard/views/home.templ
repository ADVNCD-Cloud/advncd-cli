package views

import "time"

type HomeServiceRowVM struct {
	Name   string
	Status string
	URL    string
}

type HomeVM struct {
	Error string
	Now   time.Time

	// Auth
	AuthStatus     string // ok / missing / expired
	AuthHint       string
	Email          string
	TokenExpiresIn string
	CredsPath      string

	// Context
	ProjectStatus string // ok / missing
	ProjectHint   string
	ProjectID     string
	Region        string
	ConfigPath    string

	// Services summary
	ServicesTotal  int
	ServicesReady  int
	ServicesIssues int

	Services []HomeServiceRowVM
}

templ Home(vm HomeVM) {
<div class="max-w-6xl">

	<div class="flex items-start justify-between gap-4">
		<div>
			<h1 class="text-2xl font-semibold">Overview</h1>
			<p class="text-base-content/70 mt-1">Snapshot of your current Cloud Run context.</p>
		</div>

		<div class="flex gap-2 flex-wrap justify-end">
			<a class="btn btn-sm btn-outline" href="/services">Services</a>
			<a class="btn btn-sm btn-ghost" href="https://console.cloud.google.com/run" target="_blank" rel="noopener">GCP Console ↗</a>
			<button class="btn btn-sm btn-ghost" type="button" id="copy-publish">Copy: advncd publish</button>
		</div>
	</div>

	<script>
document.addEventListener("click", async (e) => {
  const btn = e.target.closest("#copy-publish");
  if (!btn) return;
  try {
    await navigator.clipboard.writeText("advncd publish");
    const prev = btn.textContent;
    btn.textContent = "Copied ✓";
    setTimeout(() => { btn.textContent = prev; }, 1500);
  } catch (_) {}
});
	</script>

	if vm.Error != "" {
		<div class="alert alert-error mt-6">
			<span>{vm.Error}</span>
		</div>
	}

	<!-- Stat cards -->
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<div class="flex items-center justify-between">
					<h2 class="card-title text-base">Auth</h2>
					if vm.AuthStatus == "ok" {
						<span class="badge badge-success">ok</span>
					} else if vm.AuthStatus == "expired" {
						<span class="badge badge-warning">expired</span>
					} else {
						<span class="badge badge-error">missing</span>
					}
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">email</div>
					<div class="font-medium break-all">{vm.Email}</div>
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">token_expires_in</div>
					<div class="font-mono">{vm.TokenExpiresIn}</div>
				</div>

				if vm.AuthHint != "" {
					<div class="mt-3 text-xs text-base-content/60">{vm.AuthHint}</div>
				}
			</div>
		</div>

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<div class="flex items-center justify-between">
					<h2 class="card-title text-base">Context</h2>
					if vm.ProjectStatus == "ok" {
						<span class="badge badge-success">set</span>
					} else {
						<span class="badge badge-error">missing</span>
					}
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">project</div>
					<div class="font-medium break-all">{vm.ProjectID}</div>
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">region</div>
					<div class="font-mono">{vm.Region}</div>
				</div>

				if vm.ProjectHint != "" {
					<div class="mt-3 text-xs text-base-content/60">{vm.ProjectHint}</div>
				}
			</div>
		</div>

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<div class="flex items-center justify-between">
					<h2 class="card-title text-base">Services</h2>
					<span class="badge badge-neutral">{itoa(vm.ServicesTotal)}</span>
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">ready</div>
					<div class="text-3xl font-semibold">{itoa(vm.ServicesReady)}</div>
				</div>

				<div class="mt-3 text-xs text-base-content/60">
					<a class="link" href="/services">View all →</a>
				</div>
			</div>
		</div>

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<div class="flex items-center justify-between">
					<h2 class="card-title text-base">Issues</h2>
					if vm.ServicesIssues > 0 {
						<span class="badge badge-warning">{itoa(vm.ServicesIssues)}</span>
					} else {
						<span class="badge badge-success">0</span>
					}
				</div>

				<div class="mt-3 text-sm">
					<div class="text-base-content/60">not ready</div>
					<div class="text-3xl font-semibold">{itoa(vm.ServicesIssues)}</div>
				</div>

				<div class="mt-3 text-xs text-base-content/60">
					Open a service and check Logs / Metrics.
				</div>
			</div>
		</div>

	</div>

	<!-- Services table -->
	<div class="card bg-base-100 shadow mt-6">
		<div class="card-body">
			<div class="flex items-center justify-between">
				<h2 class="card-title">Services</h2>
				<a class="btn btn-sm btn-outline" href="/services">Open list</a>
			</div>

			if vm.Services == nil || len(vm.Services) == 0 {
				<div class="mt-4 text-sm text-base-content/70">
					No services found. Deploy one with <span class="font-mono">advncd publish</span>.
				</div>
			} else {
				<div class="overflow-x-auto mt-4">
					<table class="table table-zebra">
						<thead>
							<tr>
								<th>Name</th>
								<th>Status</th>
								<th>URL</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range vm.Services {
								<tr>
									<td>
										<a class="link font-mono" href={"/services/" + s.Name}>{s.Name}</a>
									</td>
									<td>
										if s.Status == "READY" {
											<span class="badge badge-success">READY</span>
										} else {
											<span class="badge badge-ghost">{s.Status}</span>
										}
									</td>
									<td class="truncate max-w-xs">
										if s.URL != "" {
											<a class="link" href={s.URL} target="_blank" rel="noopener">{s.URL}</a>
										} else {
											<span class="text-base-content/50">—</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				<div class="mt-3">
					<a class="link" href="/services">View all services →</a>
				</div>
			}

			<div class="mt-6 text-xs text-base-content/50">
				Rendered at {vm.Now.Format("2006-01-02 15:04:05")}
			</div>
		</div>
	</div>

</div>
}