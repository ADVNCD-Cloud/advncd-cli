package views

import (
	"time"
)

type ServicesRowVM struct {
	Name        string
	SourceType  string
	Status      string
	URL         string
	UpdatedText string
	DetailHref  string
	LogsURL     string
	MetricsURL  string
	RedeployURL string
	DeleteURL   string
	DisableURL  string
}

type ServicesListVM struct {
	Error string

	Project string
	Region  string

	Services []ServicesRowVM

	Now time.Time
}

templ ServicesList(vm ServicesListVM) {
<div class="max-w-6xl">
	<div class="flex items-start justify-between gap-4">
		<div>
			<h1 class="text-2xl font-semibold" style="color:#ffffff;">Services</h1>
			<p class="mt-1 text-sm" style="color:#8b7fa8;">
				Cloud Run · <span class="font-mono" style="color:#b0f0ff;">{vm.Project}</span> · <span class="font-mono" style="color:#b0f0ff;">{vm.Region}</span>
			</p>
		</div>
		<a class="btn btn-sm btn-outline" href="/">← Overview</a>
	</div>

	if vm.Error != "" {
		<div class="alert alert-error mt-6">
			<span>{vm.Error}</span>
		</div>
	}

	if vm.Error == "" {
		if vm.Services == nil || len(vm.Services) == 0 {
			<div class="card mt-6">
				<div class="card-body" style="padding:1.5rem;">
					<p style="color:#8b7fa8;font-size:0.9rem;">No services found in this project and region.</p>
					<p style="color:#8b7fa8;font-size:0.85rem;margin-top:0.5rem;">Deploy one with <code>advncd deploy</code> or use <a class="link" href="/deploy-local">Deploy Local</a>.</p>
				</div>
			</div>
		} else {
			<div class="card mt-6">
				<div class="card-body" style="padding:1.25rem;">
					<div class="overflow-x-auto">
						<table class="table table-zebra">
							<thead>
								<tr>
									<th>Name</th>
									<th>Source</th>
									<th>Status</th>
									<th>URL</th>
									<th>Updated</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								for _, s := range vm.Services {
									<tr>
										<td>
											<a class="link font-mono" href={s.DetailHref} style="font-size:0.85rem;">{s.Name}</a>
										</td>
										<td>
											if s.SourceType != "" {
												<span class="badge badge-ghost">{s.SourceType}</span>
											} else {
												<span style="color:#8b7fa8;">—</span>
											}
										</td>
										<td>
											if s.Status == "ready" {
												<span class="badge badge-success">ready</span>
											} else if s.Status == "error" {
												<span class="badge badge-error">error</span>
											} else {
												<span class="badge badge-ghost">unknown</span>
											}
										</td>
										<td class="truncate max-w-xs" style="font-size:0.8rem;">
											if s.URL != "" {
												<a class="link" href={s.URL} target="_blank" rel="noopener">{s.URL}</a>
											} else {
												<span style="color:#8b7fa8;">—</span>
											}
										</td>
										<td style="font-size:0.75rem;color:#8b7fa8;">{s.UpdatedText}</td>
										<td class="text-right">
											<div class="flex gap-1 flex-wrap justify-end">
												if s.URL != "" {
													<a class="btn btn-xs btn-outline" href={s.URL} target="_blank" rel="noopener">Open</a>
												}
												if s.LogsURL != "" {
													<a class="btn btn-xs btn-ghost" href={s.LogsURL} target="_blank" rel="noopener">Logs</a>
												}
												if s.MetricsURL != "" {
													<a class="btn btn-xs btn-ghost" href={s.MetricsURL} target="_blank" rel="noopener">Metrics</a>
												}
												<form method="post" action={s.RedeployURL}>
													<input type="hidden" name="return_to" value="/services" />
													<button class="btn btn-xs btn-ghost" type="submit">Redeploy</button>
												</form>
												<form method="post" action={s.DeleteURL} onsubmit="return confirm('Delete this service?');">
													<input type="hidden" name="return_to" value="/services" />
													<button class="btn btn-xs btn-error btn-outline" type="submit">Delete</button>
												</form>
												<form method="post" action={s.DisableURL} onsubmit="return confirm('Disable public traffic for this service?');">
													<input type="hidden" name="return_to" value="/services" />
													<button class="btn btn-xs btn-warning btn-outline" type="submit">Disable</button>
												</form>
												<a class="btn btn-xs btn-ghost" href={s.DetailHref}>Details</a>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		}

		<div class="mt-4" style="font-size:0.72rem;color:#8b7fa8;font-family:'SUSE Mono',monospace;">
			rendered { vm.Now.Format("2006-01-02 15:04:05") }
		</div>
	}
</div>
}
