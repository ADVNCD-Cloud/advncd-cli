package views

import (
	"time"
)

type ServicesRowVM struct {
	Name        string
	SourceType  string
	Status      string
	URL         string
	UpdatedText string
	DetailHref  string
	LogsURL     string
	MetricsURL  string
	RedeployURL string
	DeleteURL   string
	DisableURL  string
}

type ServicesListVM struct {
	Error string

	Project string
	Region  string

	Services []ServicesRowVM

	Now time.Time
}

templ ServicesList(vm ServicesListVM) {
<div class="max-w-5xl">
	<h1 class="text-2xl font-semibold">Services</h1>
	<p class="text-base-content/70 mt-1">
		Cloud Run services in {vm.Project} ({vm.Region})
	</p>

	if vm.Error != "" {
		<div class="alert alert-error mt-6">
			<span>{vm.Error}</span>
		</div>
	}

	if vm.Error == "" {
		<div class="overflow-x-auto mt-6">
			<table class="table table-zebra">
				<thead>
					<tr>
						<th>Name</th>
						<th>Source</th>
						<th>Status</th>
						<th>URL</th>
						<th>Updated</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, s := range vm.Services {
						<tr>
							<td class="font-mono"><a class="link" href={s.DetailHref}>{s.Name}</a></td>
							<td>
								if s.SourceType != "" {
									<span class="badge badge-ghost">{s.SourceType}</span>
								} else {
									<span class="text-base-content/50">—</span>
								}
							</td>
							<td>
								if s.Status == "ready" {
									<span class="badge badge-success">ready</span>
								} else if s.Status == "error" {
									<span class="badge badge-error">error</span>
								} else {
									<span class="badge badge-ghost">unknown</span>
								}
							</td>
							<td class="truncate max-w-xs">
								if s.URL != "" {
									<a class="link" href={s.URL} target="_blank">
										{s.URL}
									</a>
								} else {
									<span class="text-base-content/50">—</span>
								}
							</td>
							<td class="text-xs text-base-content/70">{s.UpdatedText}</td>
							<td class="text-right">
								<div class="flex gap-2 flex-wrap justify-end">
								if s.URL != "" {
									<a
										class="btn btn-sm"
										href={s.URL}
										target="_blank"
									>
										Open
									</a>
								}
								if s.LogsURL != "" {
									<a
										class="btn btn-sm btn-outline"
										href={s.LogsURL}
										target="_blank"
									>
										Logs
									</a>
								}
								if s.MetricsURL != "" {
									<a
										class="btn btn-sm btn-outline"
										href={s.MetricsURL}
										target="_blank"
									>
										Metrics
									</a>
								}
								<form method="post" action={s.RedeployURL}>
									<input type="hidden" name="return_to" value="/services" />
									<button class="btn btn-sm btn-ghost" type="submit">Redeploy</button>
								</form>
								<form method="post" action={s.DeleteURL} onsubmit="return confirm('Delete this service?');">
									<input type="hidden" name="return_to" value="/services" />
									<button class="btn btn-sm btn-error btn-outline" type="submit">Delete</button>
								</form>
								<form method="post" action={s.DisableURL} onsubmit="return confirm('Disable public traffic for this service?');">
									<input type="hidden" name="return_to" value="/services" />
									<button class="btn btn-sm btn-warning btn-outline" type="submit">Disable Public</button>
								</form>
								<a
									class="btn btn-sm btn-ghost"
									href={s.DetailHref}
								>
									Details
								</a>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<div class="mt-4 text-xs text-base-content/50">
			Rendered at { vm.Now.Format("2006-01-02 15:04:05") }
		</div>
	}
</div>
}
