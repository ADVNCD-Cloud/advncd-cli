package views

import "time"

type OverviewVM struct {
	Error string

	AuthStatus     string // ok / missing / expired
	AuthHint       string
	Email          string
	TokenExpiresIn string
	CredsPath      string

	ProjectStatus string // ok / missing
	ProjectHint   string
	ProjectID     string
	Region        string
	ConfigPath    string

	Now time.Time
}

templ Overview(vm OverviewVM) {
<div class="max-w-4xl">
	<h1 class="text-2xl font-semibold">Overview</h1>
	<p class="text-base-content/70 mt-1">Local-first control plane for your Google Cloud.</p>

	if vm.Error != "" {
		<div class="alert alert-error mt-6">
			<span>{vm.Error}</span>
		</div>
	}

	<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<h2 class="card-title">Auth</h2>

				<div class="flex items-center gap-2">
					if vm.AuthStatus == "ok" {
						<div class="badge badge-success">ok</div>
					} else if vm.AuthStatus == "expired" {
						<div class="badge badge-warning">expired</div>
					} else {
						<div class="badge badge-error">missing</div>
					}
					<span class="text-base-content/80">Google OAuth</span>
				</div>

				<div class="mt-3 space-y-1 text-sm">
					<div>
						<span class="text-base-content/60">email:</span>
						<span>{vm.Email}</span>
					</div>
					<div>
						<span class="text-base-content/60">token_expires_in:</span>
						<span>{vm.TokenExpiresIn}</span>
					</div>
					<div>
						<span class="text-base-content/60">creds:</span>
						<span>{vm.CredsPath}</span>
					</div>
				</div>

				if vm.AuthHint != "" {
					<div class="alert alert-info mt-4">
						<span>{vm.AuthHint}</span>
					</div>
				}
			</div>
		</div>

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<h2 class="card-title">Project</h2>

				<div class="flex items-center gap-2">
					if vm.ProjectStatus == "ok" {
						<div class="badge badge-success">ok</div>
					} else {
						<div class="badge badge-error">missing</div>
					}
					<span class="text-base-content/80">Context</span>
				</div>

				<div class="mt-3 space-y-1 text-sm">
					<div>
						<span class="text-base-content/60">project:</span>
						<span>{vm.ProjectID}</span>
					</div>
					<div>
						<span class="text-base-content/60">region:</span>
						<span>{vm.Region}</span>
					</div>
					<div>
						<span class="text-base-content/60">config:</span>
						<span>{vm.ConfigPath}</span>
					</div>
				</div>

				if vm.ProjectHint != "" {
					<div class="alert alert-info mt-4">
						<span>{vm.ProjectHint}</span>
					</div>
				}
			</div>
		</div>

	</div>

	<div class="mt-6 text-xs text-base-content/50">
		Rendered at { vm.Now.Format("2006-01-02 15:04:05") }
	</div>
</div>
}